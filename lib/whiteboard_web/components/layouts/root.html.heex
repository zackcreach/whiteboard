<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content="Track your progress" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Whiteboard" />
    <meta property="og:description" content="Track your progress" />
    <meta property="og:image" content="https://res.cloudinary.com/zackcreach/image/upload/w_1200,h_1200,c_limit,q_auto,f_jpg/v1786657359/khuypmp9z4hoojnywcix.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Whiteboard" />
    <meta name="twitter:description" content="Track your progress" />
    <meta name="twitter:image" content="https://res.cloudinary.com/zackcreach/image/upload/w_1200,h_1200,c_limit,q_auto,f_jpg/v1786657359/khuypmp9z4hoojnywcix.jpg" />
    <.live_title>
      {assigns[:page_title] || "Whiteboard"}
    </.live_title>
    <script>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>

  <body class="bg-white dark:bg-stone-900 text-stone-900 dark:text-white transition-colors duration-200">
    <header class="py-4 px-4 md:px-8 bg-zinc-100 dark:bg-stone-800 flex justify-between items-center gap-x-4 transition-colors duration-200">
      <a href={~p"/"} target="_self">
        <p class="text-lg uppercase font-black tracking-tight">whiteboard</p>
      </a>

      <div class="flex items-center">
        <ul class="flex items-center gap-4 [&>li]:text-xs mr-2">
          <%= if @current_user do %>
            <li>
              <.link href={~p"/workouts"}>
                Workouts
              </.link>
            </li>
            <li>
              <.link href={~p"/exercises"}>
                Exercises
              </.link>
            </li>
          <% else %>
            <li>
              <.link href={~p"/users/register"}>
                Register
              </.link>
            </li>
            <li>
              <.link href={~p"/users/log_in"}>
                Login
              </.link>
            </li>
          <% end %>
        </ul>
        <.icon_link
          :if={@current_user}
          href={~p"/users/settings"}
          icon="hero-cog-6-tooth"
          icon_class="size-5"
          label="Settings"
          class="p-2 text-zinc-900 dark:text-white"
        />
      </div>
    </header>
    {@inner_content}
  </body>
</html>
